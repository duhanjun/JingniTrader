{# 资金流分析报告模板 — 继承统一骨架 base.html.j2（示例插件） #}
{% extends "base.html.j2" %}

{% block title %}{{ title }}{% endblock %}

{% block head_css %}
/* 资金流报告专属样式 */
.capital-flow-hero {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-bottom: 16px;
}
{% endblock %}

{% block content %}
{{ page_header(title, subtitle) }}

<div class="section">
    <h2>资金流向概览</h2>
    <div class="capital-flow-hero">
        {{ metric_card(main_inflow, "主力净流入(近5日)") }}
        {{ metric_card(north_inflow, "北向资金(近5日)") }}
        {{ metric_card(vol_trend, "量能活跃度(5日/20日)") }}
    </div>
</div>

{% if charts %}
<div class="section">
    <h2>价格走势</h2>
    <div class="chart-container">{{ charts | safe }}</div>
</div>
{% endif %}

<div class="section">
    <h2>说明</h2>
    <p>本报告为<b>资金流分析报告插件</b>的演示输出。量价代理指标基于行情数据中的
       成交量与涨跌近似估算，真实资金流（主力/北向/龙虎榜）需对接对应数据源。
       可通过修改 <code>plugins/capital_flow_report/render.py</code> 接入真实资金流数据。</p>
</div>
{% endblock %}
