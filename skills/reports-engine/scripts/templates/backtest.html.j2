{# 策略回测绩效报告模板 — 继承统一骨架 base.html.j2（阶段一） #}
{% extends "base.html.j2" %}

{% block title %}{{ title }}{% endblock %}

{% block head_css %}
/* ── 回测报告特有样式 ── */
.metric-value { font-size: 28px; font-weight: 700; color: #17223b; }
.metric-label { font-size: 13px; color: #6b778d; margin-top: 4px; }
.metric-value.positive { color: #ff6768; }
.metric-value.negative { color: #12a05c; }
tr:hover { background: #fafafa; }
{% endblock %}

{% block content %}
{{ page_header(title, subtitle) }}

<div class="section">
    <h2>绩效概览</h2>
    <div class="metrics-grid">
        {% for item in metrics_display %}
            {{ metric_card(item["formatted"], item["label"], item["pos_cls"]) }}
        {% endfor %}
    </div>
</div>

{% for chart_html in charts %}
<div class="section"><div class="chart-container">{{ chart_html | safe }}</div></div>
{% endfor %}

{% if factor_summary_html %}
<div class="section"><h2>策略因子清单</h2>{{ factor_summary_html | safe }}</div>
{% endif %}
{% endblock %}
