{# ============================================================================
   base.html.j2 — 统一报告骨架模板（阶段一）

   职责：
   - 定义所有报告共用的 HTML 页面骨架（<!DOCTYPE html> / <head> / <body>）
   - 提供公共组件宏：导航栏 nav_bar / 正文标题 page_header / 指标卡 metric_card /
     section 区块 section_block / 免责声明+版权 footer_block
   - 各报告通过 {% extends "base.html.j2" %} 继承，只覆盖：
       {% block title %}        —— 页面 <title>
       {% block head_css %}     —— 追加专属 CSS（可选，回测报告为空）
       {% block content %}      —— 正文内容
     nav / footer 默认由 base 提供，也可通过 {% block nav %} / {% block footer %} 覆盖

   渲染所需 context（由 Python 端注入）：
       base_css    —— 统一样式（common_components.build_page_css()，可为空字符串）
       logo_svg    —— 惊泥 Logo SVG 内嵌内容
       nav_title   —— 导航栏右侧显示的报告标题（可选）
       disclaimer  —— 报告定制的免责声明正文
   ============================================================================
#}

{# ── 公共组件宏 ──────────────────────────────────────────────── #}

{# 顶部导航栏 #}
{% macro nav_bar(report_title="") %}
<nav class="jm-nav-bar">
    <a class="jm-nav-brand" href="https://github.com/duhanjun/jingni-trader" target="_blank" rel="noopener" title="GitHub 仓库">
        <span class="brand-logo">{{ logo_svg | safe }}</span>
        <span>JingniTrader</span>
    </a>
    {% if report_title %}<div class="jm-nav-meta">{{ report_title }}</div>{% endif %}
</nav>
{% endmacro %}

{# 正文标题 header（统一高度/样式） #}
{% macro page_header(title, subtitle="") %}
<div class="header">
    <h1>{{ title }}</h1>
    {% if subtitle %}<p>{{ subtitle }}</p>{% endif %}
</div>
{% endmacro %}

{# 指标卡片 #}
{% macro metric_card(value, label, value_cls="") %}
<div class="metric-card">
    <div class="metric-value {{ value_cls }}">{{ value }}</div>
    <div class="metric-label">{{ label }}</div>
</div>
{% endmacro %}

{# 章节区块（用 {% call section_block("标题") %}...{% endcall %} 包裹内容） #}
{% macro section_block(title) %}
<div class="section">
    <h2>{{ title }}</h2>
    {{ caller() }}
</div>
{% endmacro %}

{# 底部免责声明 + 版权 #}
{% macro footer_block(disclaimer) %}
<div class="jm-disclaimer">
    <div class="jm-disclaimer-title">⚠️ 免责声明</div>
    {{ disclaimer }}
</div>
<footer class="jm-footer">
    <div class="footer-copyright">© 2026 JingniTrader · 惊泥科技</div>
    <div class="footer-license">基于 <a href="https://opensource.org/licenses/MIT" target="_blank" rel="noopener">MIT 开源协议</a> 发布 · <a href="https://github.com/duhanjun/jingni-trader" target="_blank" rel="noopener">GitHub 仓库</a></div>
</footer>
{% endmacro %}

{# ── 统一页面骨架 ────────────────────────────────────────────── #}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="simulation_only" content="true">
    <title>{% block title %}{% endblock %}</title>
    <style>
        {{ base_css | safe }}
        {% block head_css %}{% endblock %}
    </style>
</head>
<body>
    {% block nav %}{{ nav_bar(report_title=nav_title) }}{% endblock %}
    {% block content %}{% endblock %}
    {% block footer %}{{ footer_block(disclaimer) }}{% endblock %}
</body>
</html>
